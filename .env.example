# Discord bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=

# Application ID from https://discord.com/developers/applications -> General Information (Application ID)
CLIENT_ID=

# Optional. Your Discord server ID. When set, slash commands register instantly to that server.
# Leave empty on a public host so commands register globally (can take up to an hour the first time).
GUILD_ID=

# Optional dashboard authentication. Leave blank only if the dashboard is not exposed publicly.
DASHBOARD_TOKEN=
DASHBOARD_PORT=
